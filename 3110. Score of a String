class Solution:
    def scoreOfString(s):
        sumtotal = ord(s[0])
        result = 0
        for i in range(1, len(s)):
            sumtotal = abs(sumtotal - ord(s[i]))
            result = result + sumtotal
            sumtotal = ord(s[i])
        return result

s = 'zaz'
print(Solution.scoreOfString(s))
