class Solution:
    def findWords(words):
        keyboard = ["qwertyuiopQWERTYUIOP","asdfghjklASDFGHJKL","zxcvbnmZXCVBNM"]
        arr_result = []
        checking_word = ''
        for i in keyboard:
            for j in words:
                for k in j:
                    if k not in i:
                        continue
                    else:
                        checking_word = checking_word + k
                if checking_word == j:
                    arr_result.append(checking_word)
                checking_word = ''
        return arr_result
                    

