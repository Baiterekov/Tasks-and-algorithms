class Solution:
    def reverseBits(n):
        binary_version = ""
        result = 0
        while n>0:
            binary_version =  str(n%2) + binary_version
            n = n//2
        for i in range(0, 32-len(binary_version)):
            binary_version = "0" + binary_version
        for j in range(0, 32):
            if binary_version[j] == "1":
                result = result + 2**j
        return result
